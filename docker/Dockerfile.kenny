# KENNY: single-stage image for Railway — kenny_server (github webhook + /kenny/v1 API)
FROM python:3.12.13-slim

RUN apt update && apt install --no-install-recommends -y git curl && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ADD pyproject.toml .
ADD requirements.txt .
ADD docs docs
RUN pip install --no-cache-dir . && rm pyproject.toml requirements.txt
ENV PYTHONPATH=/app
ADD pr_agent pr_agent

# Railway injects PORT; describe/review runs are long, hence the generous timeout.
CMD ["sh", "-c", "python -m gunicorn -k uvicorn.workers.UvicornWorker -w 2 --timeout 300 --forwarded-allow-ips '*' -b 0.0.0.0:${PORT:-3000} pr_agent.servers.kenny_server:app"]
